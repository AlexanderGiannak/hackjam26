# Copy to .env.local for local dev. In production set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Supabase (optional: without these the app runs in browser-only demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (optional stretch: enables "Fill in from photo"). Server-side only, no NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Email drafts go to a teammate while testing.
NEXT_PUBLIC_TEST_EMAIL=
# Only set to true once USF gives permission to email Facilities for real.
NEXT_PUBLIC_USE_REAL_FACILITIES_EMAIL=false

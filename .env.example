# Copy to .env.local for local dev. In production set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values. With NONE of these set, the app runs in demo mode (data in the browser, seeded week).

# ---- Server mode (Supabase). Setting NEXT_PUBLIC_SUPABASE_URL switches the app from demo mode to the server API.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never prefix with NEXT_PUBLIC_. The browser gets no database access at all.
SUPABASE_SERVICE_ROLE_KEY=
# Passcode for the USF staff console (/ops). Required in server mode, or the console stays off.
OPS_PASSCODE=

# ---- Gemini photo triage (optional). Server-side only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Email drafts go to a teammate while testing.
NEXT_PUBLIC_TEST_EMAIL=
# Only set to true once USF gives permission to email offices for real.
NEXT_PUBLIC_USE_REAL_OFFICE_EMAIL=false
